    "settings_quiet_hours_footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background password checks are skipped during quiet hours. A check scheduled for the configured time can still run exactly at that time."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W godzinach ciszy sprawdzanie has\u0142a w tle jest pomijane. Sprawdzenie zaplanowane na ustawion\u0105 godzin\u0119 mo\u017ce jednak wykona\u0107 si\u0119 dok\u0142adnie o tej porze."
          }
        }
      }
    },
