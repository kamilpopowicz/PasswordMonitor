    "alert_advice_default": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is still valid, but company policy requires a change every 30 days. Change it in advance."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje has\u0142o jest jeszcze wa\u017cne, ale polityka firmy wymaga zmiany co 30 dni. Zmie\u0144 je z wyprzedzeniem."
          }
        }
      }
    },
    "alert_advice_expired": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password has already expired. Change it immediately to avoid login issues."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje has\u0142o ju\u017c wygas\u0142o. Zmie\u0144 je natychmiast, aby unikn\u0105\u0107 problem\u00f3w z logowaniem."
          }
        }
      }
    },
    "alert_advice_today": {
      "extractionState": "stale",
      "localizations": {
        "en": {
