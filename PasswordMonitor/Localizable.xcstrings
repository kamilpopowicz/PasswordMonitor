    "alert_advice_default": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password is still valid, but company policy requires a change every 30 days. Change it in advance."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje hasło jest jeszcze ważne, ale polityka firmy wymaga zmiany co 30 dni. Zmień je z wyprzedzeniem."
          }
        }
      }
    },
    "alert_advice_expired": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password has already expired. Change it immediately to avoid login issues."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje hasło już wygasło. Zmień je natychmiast, aby uniknąć problemów z logowaniem."
          }
        }
      }
    },
