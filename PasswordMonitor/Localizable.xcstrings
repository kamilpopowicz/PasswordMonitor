    "unit_day %lld": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days"
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dni"
