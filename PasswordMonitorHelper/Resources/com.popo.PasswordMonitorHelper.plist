<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.company.PasswordMonitorHelper</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/PasswordMonitorHelper</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
	</array>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/tmp/password-monitor-helper.out</string>
	<key>StandardErrorPath</key>
	<string>/tmp/password-monitor-helper.err</string>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
